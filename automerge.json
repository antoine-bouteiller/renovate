{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Auto-merge all patch, minor, and lock file maintenance updates",
      "matchUpdateTypes": ["patch", "minor", "lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge GitHub Actions patch and digest updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true
    }
  ]
}
