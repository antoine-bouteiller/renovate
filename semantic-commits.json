{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["type/major"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessageExtra": "( {{currentVersion}} ➜ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["type/minor"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessageExtra": "( {{currentVersion}} ➜ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["type/patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessageExtra": "( {{currentVersion}} ➜ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["digest"],
      "labels": ["type/digest"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessageExtra": "( {{currentDigestShort}} ➜ {{newDigestShort}} )"
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["renovate/github-action"],
      "semanticCommitType": "ci",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["renovate/npm"],
      "commitMessageTopic": "package {{depName}}"
    },
    {
      "matchManagers": ["mise"],
      "addLabels": ["renovate/mise"],
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "matchManagers": ["pip_requirements", "pip-compile", "pep621", "uv"],
      "addLabels": ["renovate/python"],
      "commitMessageTopic": "package {{depName}}"
    },
    {
      "matchDepTypes": [
        "devDependencies",
        "dependency-groups",
        "project.optional-dependencies",
        "tool.uv.dev-dependencies",
        "dev",
        "optional-dependencies"
      ],
      "semanticCommitScope": "deps-dev"
    }
  ]
}
